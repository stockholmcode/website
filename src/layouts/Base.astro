---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SCG } from '../lib/theme.js';
import { base, assetBase } from '../lib/paths.js';

const { locale = 'sv', site, title } = Astro.props;

// Page title = "<page label> · <brand>", or just the brand on the homepage where
// no label is passed. The brand suffix lives here so a translated page label
// (from <route>_page.yaml) can never drift it.
const fullTitle = title ? `${title} · ${site.brand.name}` : site.brand.name;

// Resolve a content route (e.g. "/case") to a base+locale-aware URL.
const link = (to) => getRelativeLocaleUrl(locale, to);
const href = (item) => (item?.href ? item.href : link(item?.to ?? '/'));

// Language toggle: same page, other locale.
let rel = Astro.url.pathname;
if (base && rel.startsWith(base)) rel = rel.slice(base.length);
rel = rel.replace(/^\/(sv|en)(?=\/|$)/, '') || '/';
if (!rel.startsWith('/')) rel = '/' + rel;
const other = locale === 'sv' ? 'en' : 'sv';
const otherUrl = getRelativeLocaleUrl(other, rel);

const { nav, cta, footer, brand } = site;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/png" href={`${assetBase}assets/logo-dark.png`} />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amatic+SC:wght@400;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style is:global define:vars={{ accent: SCG.accent, bg: SCG.bg, ink: SCG.ink }}>
      html, body { margin: 0; padding: 0; background: var(--bg); scroll-behavior: smooth; overflow-x: hidden; }
      body { font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif; color: var(--ink); }
      * { box-sizing: border-box; }
      @keyframes scgCaret { 50% { opacity: 0; } }
      .scg-case-row { transition: background .2s ease; }
      .scg-case-row:hover { background: rgba(255,145,77,.04); }
      .scg-link { text-decoration: none; color: inherit; }
      .scg-footer-link { border-bottom: 1px solid transparent; transition: border-color .15s ease; }
      .scg-footer-link:hover { border-bottom-color: var(--accent); }
      .scg-nav-link { transition: color .15s ease; }
      .scg-nav-link:hover { color: var(--accent); }
    </style>
  </head>
  <body>
    <nav class="scg-nav">
      <div class="scg-nav-inner">
        <a class="scg-brand" href={link('/')}>{brand.name}</a>
        <div class="scg-nav-right" id="scg-nav-right">
          {nav.map((x) => <a class="scg-nav-link" href={href(x)}>{x.label}</a>)}
          <a class="scg-lang" href={otherUrl} aria-label="Switch language">{other.toUpperCase()}</a>
          <a class="scg-cta" href={cta.href}>{cta.label}</a>
        </div>
        <button class="scg-hamburger" id="scg-hamburger" aria-label="Öppna meny" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
    <script>
      const btn = document.getElementById('scg-hamburger');
      const nav = document.getElementById('scg-nav-right');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
        btn.classList.toggle('open', open);
      });
    </script>

    <slot />

    <footer class="scg-foot">
      <div class="scg-foot-inner">
        <div class="scg-foot-grid">
          <div>
            <img class="scg-foot-logo" src={`${assetBase}assets/logo-light.png`} alt="Stockholm Code Group" />
            <div class="scg-foot-brand">{brand.name}</div>
            <p class="scg-foot-blurb">{footer.blurb}</p>
          </div>
          {footer.columns.map((col) => (
            <div>
              <div class="scg-foot-h">{col.h}</div>
              <ul class="scg-foot-list">
                {col.items.map((it) => (
                  <li class="scg-foot-item">
                    {it.href || it.to
                      ? <a class="scg-footer-link scg-link" href={href(it)}>{it.label}</a>
                      : it.label}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="scg-foot-bottom">
          <div>{brand.copyright}</div>
          <div>{footer.tagline}</div>
        </div>
      </div>
    </footer>

    <style define:vars={{ accent: SCG.accent, bg: SCG.bg, panel: SCG.panel, ink: SCG.ink, inkDim: SCG.inkDim, line: SCG.line }}>
      .scg-nav { position: sticky; top: 0; z-index: 100; background: rgba(10,12,15,.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
      .scg-nav-inner { max-width: 1280px; margin: 0 auto; padding: 0 56px; display: flex; align-items: center; justify-content: space-between; height: 76px; position: relative; }
      .scg-brand { font-family: 'Amatic SC', cursive; font-weight: 700; font-size: 28px; line-height: 1; color: var(--ink); white-space: nowrap; text-decoration: none; }
      .scg-nav-right { display: flex; align-items: center; gap: 28px; font-size: 15px; }
      .scg-nav-link { color: var(--ink); text-decoration: none; }
      .scg-lang { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; letter-spacing: .08em; color: var(--inkDim); text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; }
      .scg-lang:hover { color: var(--accent); border-color: var(--accent); }
      .scg-cta { background: var(--accent); color: var(--bg); padding: 10px 18px; border-radius: 999px; text-decoration: none; font-size: 14px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; }

      /* Hamburger — hidden on desktop */
      .scg-hamburger { display: none; flex-direction: column; justify-content: center; gap: 5px; background: none; border: none; cursor: pointer; padding: 8px; z-index: 10; }
      .scg-hamburger span { display: block; width: 22px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .25s, opacity .25s; }
      .scg-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .scg-hamburger.open span:nth-child(2) { opacity: 0; }
      .scg-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

      @media (max-width: 960px) {
        .scg-nav-inner { padding: 0 20px; }
        .scg-hamburger { display: flex; }
        .scg-nav-right {
          display: none; flex-direction: column; align-items: stretch; gap: 0;
          position: absolute; top: 76px; left: 0; right: 0;
          background: rgba(10,12,15,.97); backdrop-filter: blur(16px);
          border-bottom: 1px solid var(--line); padding: 8px 20px 16px;
        }
        .scg-nav-right.open { display: flex; }
        .scg-nav-link { padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 17px; }
        .scg-lang { margin: 12px 0 4px; align-self: flex-start; }
        .scg-cta { margin-top: 8px; justify-content: center; }
      }

      .scg-foot { background: var(--bg); color: var(--ink); padding: 72px 0 40px; border-top: 1px solid var(--line); }
      .scg-foot-inner { max-width: 1280px; margin: 0 auto; padding: 0 56px; }
      .scg-foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 80px; }
      .scg-foot-logo { height: 80px; width: auto; display: block; margin-bottom: 12px; }
      .scg-foot-brand { font-family: 'Amatic SC', cursive; font-weight: 700; font-size: 22px; color: var(--ink); }
      .scg-foot-blurb { font-size: 14px; color: var(--inkDim); line-height: 1.6; margin-top: 16px; max-width: 340px; }
      .scg-foot-h { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--accent); letter-spacing: .1em; text-transform: uppercase; margin-bottom: 16px; }
      .scg-foot-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
      .scg-foot-item { font-size: 14px; color: var(--ink); white-space: pre-line; }
      .scg-foot-bottom { padding-top: 24px; border-top: 1px solid var(--line); font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--inkDim); display: flex; justify-content: space-between; letter-spacing: .06em; flex-wrap: wrap; gap: 8px; }

      @media (max-width: 960px) {
        .scg-foot-inner { padding: 0 20px; }
        .scg-foot-grid { grid-template-columns: 1fr 1fr; gap: 32px; margin-bottom: 48px; }
      }
      @media (max-width: 640px) {
        .scg-foot { padding: 48px 0 32px; }
        .scg-foot-grid { grid-template-columns: 1fr; gap: 32px; margin-bottom: 40px; }
      }
    </style>
  </body>
</html>
