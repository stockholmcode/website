---
import Base from '../../layouts/Base.astro';
import CasePage from '../../components/CasePage.astro';
import { getContent } from '../../lib/content.js';

// English locale. Content comes from src/data/en/*.yaml, falling back per-file to Swedish
// for any file not yet translated (see src/lib/content.js).
const locale = 'en';
const content = getContent(locale);
---
<Base locale={locale} site={content.site} title={content.case_page.title}>
  <CasePage locale={locale} content={content} />
</Base>
