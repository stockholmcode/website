---
import Base from '../layouts/Base.astro';
import Erbjudanden from '../components/Erbjudanden.astro';
import { getContent } from '../lib/content.js';

const locale = 'sv';
const content = getContent(locale);
---
<Base locale={locale} site={content.site} title="Erbjudanden · Stockholm Code Group">
  <Erbjudanden locale={locale} content={content} />
</Base>
