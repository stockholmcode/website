---
import { SCG } from '../lib/theme.js';

const { locale = 'sv', content } = Astro.props;

const page = content.erbjudanden_page;
const offerings = content.offerings;
const dimensions = content.dimensions;

const assetBase = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const deliverables = page.offeringDeliverables;
---
<header class="hero">
  <div class="container">
    <div class="kicker">{page.hero.kicker}</div>
    <h1>{page.hero.headlinePre}<br /><span class="accent">{page.hero.headlineAccent}</span> {page.hero.headlineMid}</h1>
    <p class="lead">
      {page.hero.lead}
      <span class="dim">{page.hero.leadDim}</span>
    </p>
  </div>
</header>

<!-- Core practice -->
<section class="core">
  <div class="container">
    <div class="head">
      <h2>{page.core.headPre}<br />{page.core.headMid} <span class="accent">{page.core.headAccent}</span></h2>
      <p class="lead">{page.core.lead}</p>
    </div>
    <div class="core-grid">
      {page.core.cards.map((card) => (
        <article class="core-card">
          <div class="top">
            <div class="num">{card.tag}</div>
            <div class="label">{card.label}</div>
          </div>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
          <ul>
            {card.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- AI track intro -->
<section class="track-intro">
  <div class="container">
    <div class="head">
      <div>
        <div class="kicker">{page.track.kicker}</div>
        <h2>{page.track.headPre}<br /><span class="accent">{page.track.headAccent}</span></h2>
      </div>
      <p>{page.track.body}</p>
    </div>

    <div class="ladder-strip">
      {page.track.ladder.map((step) => (
        <div><span class="dot" style={`opacity:${step.opacity}`}></span>{step.label}</div>
      ))}
    </div>
    <div class="ladder-line"></div>
  </div>
</section>

<!-- Offerings detailed -->
<section class="offerings">
  <div class="container">
    <div class="off-grid">
      {offerings.map((off, i) => (
        <article class:list={['off-card', { accent: i === offerings.length - 1 }]}>
          <div class="left">
            <div class="num">{off.num}</div>
            <div class="when">{off.when}</div>
          </div>
          <div class="mid">
            <div class="kicker">{off.kicker}</div>
            <h3>{off.title}</h3>
            <div class="body">
              <p>{off.body}</p>
            </div>
            <div class="pills">
              {off.bullets.map((b) => <span class="pill">{b}</span>)}
            </div>
          </div>
          <div class="right">
            <div class="deliverables">
              <h4>{deliverables.heading}</h4>
              <ul>
                {(deliverables.byNum[off.num] ?? []).map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- 5D framework -->
<section class="framework">
  <div class="container">
    <div class="head">
      <h2>{page.framework.headPre}<br /><span class="accent">{page.framework.headAccent}</span></h2>
      <p class="lead">{page.framework.lead}</p>
    </div>

    <div class="dim-grid">
      {dimensions.map((dim, i) => (
        <div class:list={['dim', { first: i === 0 }]}>
          <div class="num">{dim.num}</div>
          <h4>{dim.title}</h4>
          <p class="q">{dim.q}</p>
          <p class="body">{dim.body}</p>
        </div>
      ))}
    </div>

    <div class="dim-detail">
      {dimensions.map((dim) => (
        <div class="col">
          <div class="head-row"><div class="num">{dim.num}</div><h5>{dim.title}</h5></div>
          <div class="label red">{page.framework.signalsLabel}</div>
          <ul class="signals">
            {dim.signals.map((s) => <li>{s}</li>)}
          </ul>
          <div class="label green">{page.framework.winsLabel}</div>
          <ul class="wins">
            {dim.wins.map((w) => <li>{w}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- How to engage -->
<section class="engage">
  <div class="container">
    <h2>{page.engage.heading}</h2>
    <div class="engage-grid">
      {page.engage.steps.map((s, i) => (
        <div class:list={['engage-card', { first: i === 0 }]}>
          <div class="step">{s.step}</div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta">
  <div class="container">
    <img src={`${assetBase}assets/logo.jpg`} alt="" class="logo" />
    <h2>{page.cta.heading}</h2>
    <p>{page.cta.body}</p>
    <a class="btn" href={page.cta.buttonHref}>{page.cta.buttonLabel}</a>
  </div>
</section>

<style
  define:vars={{
    accent: SCG.accent,
    bg: SCG.bg,
    panel: SCG.panel,
    ink: SCG.ink,
    inkDim: SCG.inkDim,
    inkFaint: SCG.inkFaint,
    line: SCG.line,
    red: '#E85C5C',
    green: '#4CE87E',
  }}
>
  .container { max-width: 1280px; margin: 0 auto; padding: 0 56px; }
  .accent { color: var(--accent); }

  /* Hero */
  .hero { padding: 144px 0 96px; border-bottom: 1px solid var(--line); position: relative; overflow: hidden; }
  .hero .kicker { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; color: var(--accent);
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 20px; }
  .hero h1 { font-family: 'Amatic SC', cursive; font-weight: 700;
    font-size: clamp(96px, 13vw, 220px); line-height: .88; margin: 0;
    letter-spacing: -.005em; color: var(--ink); }
  .hero h1 .accent { color: var(--accent); }
  .hero p.lead { font-size: 22px; line-height: 1.45; max-width: 720px; margin: 48px 0 0; color: var(--ink); }
  .hero p.lead .dim { color: var(--inkDim); }

  /* Core practice */
  .core { padding: 112px 0; border-bottom: 1px solid var(--line); }
  .core .head { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: end; margin-bottom: 56px; }
  .core h2 { font-family: 'Amatic SC', cursive; font-weight: 700;
    font-size: clamp(64px, 8vw, 128px); line-height: .92; margin: 0; color: var(--ink); }
  .core h2 .accent { color: var(--accent); }
  .core .lead { font-size: 18px; line-height: 1.55; color: var(--inkDim); margin: 0; max-width: 520px; }
  .core-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .core-card { background: var(--panel); padding: 32px; border-radius: 18px; border: 1px solid var(--line);
    display: flex; flex-direction: column; gap: 14px; min-height: 380px; }
  .core-card .top { display: flex; justify-content: space-between; align-items: baseline; }
  .core-card .num { font-family: 'Amatic SC', cursive; font-weight: 700; font-size: 56px; line-height: .9; color: var(--accent); }
  .core-card .label { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 10px; color: var(--inkDim); letter-spacing: .08em; }
  .core-card h3 { font-family: 'Amatic SC', cursive; font-weight: 700; font-size: 36px; line-height: 1; margin: 0; color: var(--ink); }
  .core-card p { font-size: 14px; line-height: 1.6; color: var(--inkDim); margin: 0; flex: 1; }
  .core-card ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px;
    border-top: 1px solid var(--line); padding-top: 16px; }
  .core-card ul li { font-size: 13px; color: var(--ink); display: flex; gap: 10px; }
  .core-card ul li::before { content: '→'; color: var(--accent); font-family: 'JetBrains Mono', ui-monospace, monospace; }

  /* AI track intro */
  .track-intro { padding: 96px 0 32px; background: var(--bg); }
  .track-intro .head { display: grid; grid-template-columns: 1fr 1.6fr; gap: 48px; align-items: end; margin-bottom: 32px; }
  .track-intro .kicker { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--accent); letter-spacing: .1em; text-transform: uppercase; margin-bottom: 12px; }
  .track-intro h2 { font-family: 'Amatic SC', cursive; font-weight: 700;
    font-size: clamp(48px, 6vw, 88px); line-height: .95; margin: 0; color: var(--ink); }
  .track-intro h2 .accent { color: var(--accent); }
  .track-intro p { font-size: 16px; line-height: 1.6; color: var(--inkDim); margin: 0; max-width: 620px; }

  /* Ladder timeline */
  .ladder-strip { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--inkDim);
    letter-spacing: .12em; text-transform: uppercase;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 12px; }
  .ladder-strip > div { display: flex; align-items: center; gap: 10px; }
  .ladder-strip span.dot { width: 8px; height: 8px; border-radius: 999px; background: var(--accent); }
  .ladder-line { height: 2px; background: linear-gradient(to right, var(--accent), rgba(255,145,77,.25)); margin-bottom: 24px; }

  /* Offerings detailed */
  .offerings { padding: 0 0 112px; background: var(--bg); }
  .off-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  .off-card { background: var(--panel); border: 1px solid var(--line); border-radius: 22px;
    padding: 48px; display: grid; grid-template-columns: 200px 1fr 360px; gap: 56px; align-items: start; }
  .off-card.accent { background: var(--accent); border: none; color: var(--bg); }
  .off-card.accent .num, .off-card.accent h3, .off-card.accent .body, .off-card.accent .deliverables h4 { color: var(--bg); }
  .off-card.accent .when, .off-card.accent .body p, .off-card.accent .deliverables li { color: rgba(10,12,15,.78); }
  .off-card.accent .pill { border-color: rgba(10,12,15,.25); color: rgba(10,12,15,.78); }
  .off-card .left .num { font-family: 'Amatic SC', cursive; font-weight: 700; font-size: 88px; line-height: .9; color: var(--accent); }
  .off-card .left .when { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--inkDim); letter-spacing: .06em; margin-top: 8px; }
  .off-card .mid .kicker { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--accent); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 10px; }
  .off-card.accent .mid .kicker { color: var(--bg); opacity: .85; }
  .off-card .mid h3 { font-family: 'Amatic SC', cursive; font-weight: 700; font-size: 56px; line-height: .95; margin: 0 0 18px; color: var(--ink); }
  .off-card .mid .body p { font-size: 16px; line-height: 1.6; color: var(--inkDim); margin: 0 0 16px; }
  .off-card .mid .pills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .off-card .mid .pill { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; padding: 6px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--inkDim); }
  .off-card .right .deliverables h4 { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--accent); letter-spacing: .1em; text-transform: uppercase; margin: 0 0 14px; }
  .off-card.accent .right .deliverables h4 { color: var(--bg); opacity: .85; }
  .off-card .right .deliverables ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .off-card .right .deliverables li { font-size: 14px; color: var(--ink); display: flex; gap: 10px; line-height: 1.5; }
  .off-card .right .deliverables li::before { content: '✓'; color: var(--accent); font-weight: 700; }
  .off-card.accent .right .deliverables li::before { color: var(--bg); }

  /* 5D framework */
  .framework { padding: 112px 0; background: var(--panel); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .framework .head { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; align-items: end; margin-bottom: 56px; }
  .framework h2 { font-family: 'Amatic SC', cursive; font-weight: 700;
    font-size: clamp(56px, 7vw, 96px); line-height: .92; margin: 0; color: var(--ink); }
  .framework h2 .accent { color: var(--accent); }
  .framework .lead { font-size: 16px; line-height: 1.6; color: var(--inkDim); margin: 0; max-width: 580px; }

  .dim-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; margin-bottom: 64px; }
  .dim { padding-top: 18px; border-top: 3px solid var(--line); transition: border-color .2s; }
  .dim.first { border-top-color: var(--accent); }
  .dim .num { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--accent); letter-spacing: .06em; margin-bottom: 8px; }
  .dim h4 { font-family: 'Amatic SC', cursive; font-weight: 700; font-size: 30px; line-height: .95; margin: 0 0 10px; color: var(--ink); }
  .dim .q { font-size: 13px; line-height: 1.5; color: var(--ink); margin: 0 0 8px; font-weight: 500; }
  .dim p.body { font-size: 12px; line-height: 1.5; color: var(--inkDim); margin: 0; }

  .dim-detail { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  .dim-detail .col { background: var(--bg); border: 1px solid var(--line); border-radius: 14px; padding: 24px; }
  .dim-detail .col .head-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; }
  .dim-detail .col .num { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--accent); letter-spacing: .06em; }
  .dim-detail .col h5 { font-family: 'Amatic SC', cursive; font-weight: 700; font-size: 26px; line-height: 1; margin: 0; color: var(--ink); }
  .dim-detail .col .label { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 9px; letter-spacing: .12em; text-transform: uppercase; margin: 14px 0 8px; }
  .dim-detail .col .label.red { color: var(--red); }
  .dim-detail .col .label.green { color: var(--green); }
  .dim-detail .col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .dim-detail .col ul li { font-size: 12px; line-height: 1.45; color: var(--ink); display: flex; gap: 8px; }
  .dim-detail .col ul.signals li::before { content: '×'; color: var(--red); font-weight: 700; }
  .dim-detail .col ul.wins li::before { content: '→'; color: var(--green); font-weight: 700; }

  /* How to engage */
  .engage { padding: 112px 0; }
  .engage h2 { font-family: 'Amatic SC', cursive; font-weight: 700;
    font-size: clamp(56px, 7vw, 112px); line-height: .92; margin: 0 0 56px; color: var(--ink); }
  .engage h2 .accent { color: var(--accent); }
  .engage-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .engage-card { padding-top: 24px; border-top: 2px solid var(--line); }
  .engage-card.first { border-top-color: var(--accent); }
  .engage-card .step { font-family: 'Amatic SC', cursive; font-weight: 700; font-size: 64px; line-height: .9; color: var(--accent); }
  .engage-card h3 { font-family: 'Amatic SC', cursive; font-weight: 700; font-size: 36px; line-height: .95; margin: 8px 0 12px; color: var(--ink); }
  .engage-card p { font-size: 14px; line-height: 1.6; color: var(--inkDim); margin: 0; }

  /* CTA */
  .cta { background: var(--accent); padding: 120px 0; text-align: center; }
  .cta img.logo { height: 120px; width: auto; margin-bottom: 24px; filter: invert(0); }
  .cta h2 { font-family: 'Amatic SC', cursive; font-weight: 700;
    font-size: clamp(72px, 10vw, 160px); line-height: .92; margin: 0 0 20px; color: var(--bg); }
  .cta p { font-size: 20px; line-height: 1.5; margin: 0 auto 40px; max-width: 640px; color: var(--bg); }
  .cta .btn { display: inline-flex; align-items: center; gap: 10px;
    background: var(--bg); color: var(--ink); padding: 16px 26px; border-radius: 999px;
    text-decoration: none; font-size: 16px; font-weight: 600; }
</style>
